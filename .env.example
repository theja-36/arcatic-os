# ---- Supabase (local values printed by `supabase start`) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- API ----
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# ---- AI ----
ANTHROPIC_API_KEY=
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# optional tag on every trace/score (e.g. staging)
LANGFUSE_ENVIRONMENT=
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
COMFYUI_URL=http://localhost:8188
COMFYUI_SHARED_SECRET=

# ---- Ingestion ----
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=
DOCLING_SERVICE_URL=http://localhost:5001
DOCLING_API_KEY=
WHISPER_URL=http://localhost:9000
WHISPER_MODEL=Systran/faster-whisper-large-v3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Latin-only drawtext fallback; Telugu etc. text is drawn in the browser (docs/14)
RENDER_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Optional: start renders on a dedicated queue (run a worker with ARCATIC_TASK_QUEUE set to the same value)
ARCATIC_RENDER_TASK_QUEUE=

# ---- Embeddings (vector(1024)) — "tei" (self-hosted bge-m3, default) or "voyage" ----
EMBEDDINGS_PROVIDER=tei
EMBEDDINGS_URL=http://localhost:8080
EMBEDDINGS_MODEL=bge-m3
VOYAGE_API_KEY=

# ---- Google Drive import (Picker, drive.file scope) ----
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# ---- Publishing / email / analytics ----
POSTIZ_URL=http://localhost:4007/api
# Web app origin: where Postiz connect pages send people back to (defaults to the first API_CORS_ORIGINS entry)
APP_URL=http://localhost:3000
POSTIZ_ADMIN_KEY=
MAUTIC_URL=
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
MATOMO_URL=
MATOMO_TOKEN=

# ---- Billing ----
LAGO_API_URL=http://localhost:3010
LAGO_API_KEY=
LAGO_WEBHOOK_SECRET=
# payment provider connected in Lago (cashfree | stripe | adyen | gocardless | …) and its connection code
LAGO_PAYMENT_PROVIDER=cashfree
LAGO_PAYMENT_PROVIDER_CODE=
# staff tooling: /admin refunds and adjustments (≥ 32 random characters)
ADMIN_API_TOKEN=
# Not used: card / UPI payments are collected by the provider connected inside Lago (docs/18)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Platform ----
ENCRYPTION_KEY=
SENTRY_DSN=

# ---- Ads analytics (services/ads-sync; official google-ads / facebook-business SDKs) ----
ADS_SYNC_URL=http://localhost:8090
ADS_SYNC_SECRET=
# Google Ads API access for the platform (each workspace supplies its own refresh token + customer id)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- Notifications (Phase 12) -------------------------------------------------
# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.test
# Transactional email over SMTP. Staging: a mail catcher (Mailpit) or the provider's sandbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Arcatic <no-reply@example.test>"
# off | allowlist | all — anything but production must stay on allowlist
EMAIL_MODE=allowlist
EMAIL_ALLOWLIST=example.test
