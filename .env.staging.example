# Hosted-staging environment — NAMES ONLY. Copy to your secret manager / host dashboard;
# never commit real values and never paste them into chat. `pnpm staging:preflight` checks
# this set by name without printing any value (docs/23-hosted-staging.md).
#
# STAGING_TARGET marks the environment so scripts refuse to run against anything else.
STAGING_TARGET=staging

# ---- Supabase (hosted STAGING project; never the production project) ----
SUPABASE_URL=https://<staging-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret
SUPABASE_JWT_SECRET=                  # secret; omit on projects that sign with JWKS
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Public origins (HTTPS only: service workers, Web Push and PWA install require it) ----
APP_URL=https://staging.<your-domain>               # the web app
NEXT_PUBLIC_API_URL=https://api-staging.<your-domain>
API_PUBLIC_URL=https://api-staging.<your-domain>    # used in push receipt URLs; must be reachable from browsers
API_CORS_ORIGINS=https://staging.<your-domain>      # exact web origin(s), comma separated; no wildcard
API_PORT=4000

# ---- Temporal (Cloud namespace or self-hosted; the worker creates the 2 schedules on start) ----
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=                     # secret

# ---- Secrets generated by us (do not reuse across environments) ----
ENCRYPTION_KEY=                       # >= 32 random chars
ADMIN_API_TOKEN=                      # >= 32 random chars
VAPID_PUBLIC_KEY=                     # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=                    # secret
VAPID_SUBJECT=mailto:ops@<your-domain>
PUSH_RECEIPT_SECRET=                  # >= 32 random chars (falls back to VAPID_PRIVATE_KEY if unset)

# ---- Email: a SANDBOX / transactional provider's SMTP relay, never the production sender ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=                            # secret
EMAIL_FROM="Arcatic Staging <no-reply@staging.<your-domain>>"
EMAIL_MODE=allowlist                  # staging must never be "all"
EMAIL_ALLOWLIST=staging-inbox.<your-domain>   # test-only domain(s); no gmail/outlook/yahoo

# ---- Optional for the services flow; required for the AI / media / publishing / billing areas ----
ANTHROPIC_API_KEY=                    # secret
FIRECRAWL_URL=
FIRECRAWL_API_KEY=
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
POSTIZ_URL=
LAGO_API_URL=
LAGO_API_KEY=
LAGO_WEBHOOK_SECRET=
ADS_SYNC_URL=
ADS_SYNC_SECRET=
