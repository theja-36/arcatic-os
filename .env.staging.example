# =====================================================================================
# Arcatic — HOSTED STAGING environment: variable NAMES and DESCRIPTIONS only.
# Copy to `.env.staging` with `pnpm staging:init` (generates the secrets marked [we generate]).
# `.env.staging` is git-ignored, mode 600, and never printed or committed. Do not paste values
# into chat. Staging values must never be reused in production.
#
# Legend — who reads it:  [web] Next.js app · [api] Hono API · [worker] Temporal worker · [all]
#          secret = keep in the secret manager / .env.staging only
# =====================================================================================

# --- Environment marker -----------------------------------------------------------------
# [scripts] Must be "staging". Preflight/E2E/auth-check refuse to run otherwise.
STAGING_TARGET=staging

# --- Supabase (hosted STAGING project; never the production project) --------------------
# [api][worker][web-build] Project URL, https://<20-char-ref>.supabase.co
SUPABASE_URL=
# [web-build] Same URL, baked into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
# [api][worker] Publishable key (sb_publishable_…), from Project Settings → API Keys. Public by design; RLS protects data.
SUPABASE_PUBLISHABLE_KEY=
# [web-build] Same publishable key for the browser bundle. NEVER put the secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [api][worker] secret — Secret key (sb_secret_…). Bypasses RLS. Server only; never in the browser, never in logs.
SUPABASE_SECRET_KEY=
# Legacy equivalents (anon / service_role JWTs). Leave blank: Supabase is retiring them. If set, the new names above win.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [api] secret — Legacy HS256 JWT secret. LEAVE BLANK on a project using JWT signing keys (asymmetric): the API then
#       verifies user tokens against the project's JWKS. Setting it switches the API to HS256-only.
SUPABASE_JWT_SECRET=
# [api] Only for a custom Supabase auth domain; defaults to <SUPABASE_URL>/auth/v1.
SUPABASE_JWT_ISSUER=
# [scripts] secret — Fine-grained access token (auth_config_read) for `pnpm staging:auth`; export in your shell, don't store.
SUPABASE_ACCESS_TOKEN=
# [scripts] secret — Database password chosen at project creation, used by `supabase link` / `db push` (migration step only).
SUPABASE_DB_PASSWORD=

# --- Public origins (HTTPS only: service workers, Web Push and PWA install require it) ----
# [web-build][api][worker] Web app origin, e.g. https://staging.example.com
APP_URL=
# [web-build] Public API origin the browser calls, e.g. https://api-staging.example.com
NEXT_PUBLIC_API_URL=
# [api][worker] Same API origin; embedded in push receipt URLs, so browsers must be able to reach it.
API_PUBLIC_URL=
# [api] Exact allowed browser origins, comma separated, no wildcard. Normally just APP_URL.
API_CORS_ORIGINS=
# [api] Port the API listens on inside its container.
API_PORT=4000

# --- Temporal ----------------------------------------------------------------------------
# [api][worker] Temporal Cloud: <namespace>.<account>.tmprl.cloud:7233 · self-hosted: temporal:7233
TEMPORAL_ADDRESS=
# [api][worker] Namespace (Cloud: <namespace>.<account>) or "default" when self-hosted.
TEMPORAL_NAMESPACE=
# [api][worker] secret — Temporal Cloud API key (required for Cloud; blank when self-hosted inside the private network).
TEMPORAL_API_KEY=
# [worker] Optional task-queue overrides (leave blank for the default single queue).
ARCATIC_TASK_QUEUE=
ARCATIC_RENDER_TASK_QUEUE=
# [worker] Concurrent activities per worker process.
WORKER_MAX_ACTIVITIES=10

# --- Secrets we generate ([we generate] by `pnpm staging:init`) --------------------------
# [api][worker] secret — Encrypts stored third-party tokens (Postiz/ads). Rotating it invalidates stored tokens.
ENCRYPTION_KEY=
# [api] secret — Bearer token for /admin endpoints (staff management, refunds). Used from the operator's terminal only.
ADMIN_API_TOKEN=
# [api][worker] secret — Signs push delivery receipts (displayed/clicked). Falls back to VAPID_PRIVATE_KEY if blank.
PUSH_RECEIPT_SECRET=
# [api][worker] Web Push VAPID public key (served to browsers to subscribe).
VAPID_PUBLIC_KEY=
# [api][worker] secret — Web Push VAPID private key.
VAPID_PRIVATE_KEY=
# [api][worker] Contact the push services may use: mailto:ops@<your-domain>
VAPID_SUBJECT=

# --- Email (transactional; the SAME provider also serves Supabase Auth sign-in emails) ----
# [api][worker] SMTP relay of the email provider (e.g. smtp.resend.com).
SMTP_HOST=
# [api][worker] 587 (STARTTLS) or 465 (implicit TLS, then SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
# [api][worker] SMTP username (Resend: "resend").
SMTP_USER=
# [api][worker] secret — SMTP password / API key. Use a key restricted to sending.
SMTP_PASS=
# [api][worker] From header; the domain must be verified at the provider (SPF + DKIM) — e.g. "Arcatic Staging <no-reply@staging.example.com>"
EMAIL_FROM=
# [api][worker] off | allowlist. Staging must never be "all".
EMAIL_MODE=allowlist
# [api][worker] Who may receive app emails. Comma list of test domains and/or EXACT addresses (e.g. you+arcatic@gmail.com).
#               Never a whole public mailbox domain (gmail.com, outlook.com…).
EMAIL_ALLOWLIST=

# --- AI and knowledge (needed only for those product areas) -----------------------------
# [worker] secret — Anthropic API key (brand analysis, strategy, content, repurposing). Set a monthly spend limit in the console.
ANTHROPIC_API_KEY=
# [worker] Optional model overrides per tier (default for every tier is claude-opus-5-5): e.g. claude-haiku-5-5 for economy.
ARCATIC_MODEL_ECONOMY=
ARCATIC_MODEL_STANDARD=
ARCATIC_MODEL_PREMIUM=
# [api][worker] Embeddings: "voyage" (managed, recommended for staging) or "tei" (self-hosted, heavy).
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=
# [api][worker] secret — Voyage API key (voyage-3.5 at 1024 dimensions).
VOYAGE_API_KEY=
# [api][worker] Self-hosted embeddings endpoint, only when EMBEDDINGS_PROVIDER=tei.
EMBEDDINGS_URL=
# [worker] Website analysis. Managed Firecrawl: https://api.firecrawl.dev ; self-hosted: private URL.
FIRECRAWL_URL=
# [worker] secret — Firecrawl API key (managed).
FIRECRAWL_API_KEY=
# [worker] Document parsing (Docling Serve) — optional; PDF/Office ingestion is disabled without it.
DOCLING_SERVICE_URL=
DOCLING_API_KEY=
# [worker] Speech-to-text (OpenAI-compatible endpoint) — optional; audio/video transcripts disabled without it.
WHISPER_URL=
WHISPER_MODEL=
WHISPER_API_KEY=
# [worker] AI image generation via ComfyUI on an NVIDIA GPU host — optional; image generation disabled without it.
COMFYUI_URL=
COMFYUI_SHARED_SECRET=
# [worker] Video rendering / media probing (installed in the worker image).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# [worker] Langfuse tracing — optional.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=staging

# --- Publishing, analytics, billing, ads (each optional; the area is disabled without it) -
# [api][worker] Postiz backend URL for scheduling/publishing to social channels.
POSTIZ_URL=
POSTIZ_ADMIN_KEY=
# [worker] Analytics sources.
MATOMO_URL=
MATOMO_TOKEN=
MAUTIC_URL=
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
# [api][worker] Lago billing (use a payment-provider TEST account only).
LAGO_API_URL=
LAGO_API_KEY=
LAGO_WEBHOOK_SECRET=
LAGO_PAYMENT_PROVIDER=
LAGO_PAYMENT_PROVIDER_CODE=
# [api][worker] Google Ads / Meta insights sidecar (services/ads-sync).
ADS_SYNC_URL=
ADS_SYNC_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# [web-build] Google Drive picker (public identifiers; restrict by HTTP referrer).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# [api] Error reporting — optional.
SENTRY_DSN=
